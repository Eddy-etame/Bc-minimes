<body data-page="home">
  <div class="grain" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"><div class="cursor__ring"><span class="cursor__label">voir</span></div></div>
  <div class="cursor__dot" aria-hidden="true"></div>

  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ============================ HERO ============================ -->
    <header class="hero" data-hero="a" aria-label="Boxing Center Minimes">
      <div class="hero__stage" aria-hidden="true">
        <video id="hero-video" class="hero__src" data-video="/assets/media/clip-bags.mp4" data-poster="/assets/img/bc/anglaise-1.webp" muted loop autoplay playsinline preload="auto"></video>
        <div class="hero-a__knock">
          <div class="hero__word">
            <span class="hero__word-top" data-split>Boxing Center</span>
            <span class="hero__word-main" data-split>Minimes</span>
          </div>
        </div>
        <canvas id="hero-canvas" class="hero-b__canvas"></canvas>
        <div class="hero__word hero__word--solid">
          <span class="hero__word-top" data-split>Boxing Center</span>
          <span class="hero__word-main" data-split>Minimes</span>
        </div>
      </div>

      <h1 class="sr-only">Boxing Center Minimes — salle de boxe historique aux Minimes, Toulouse</h1>

      <div class="hero__inner">
        <p class="hero__kicker" data-reveal>Barrière de Paris — Toulouse · Depuis 2016</p>
        <p class="hero__sub" data-reveal>Le berceau des champions.<br><b>Ici, on forge.</b></p>
        <div class="hero__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic data-cursor="go" href="https://box-plus.vercel.app/seance-essai"><span>Réserver mon essai · 10€</span></a>
          <a class="btn btn--ghost" data-magnetic href="/le-club/"><span>Entrer dans le club</span></a>
        </div>
      </div>

      <button class="hero-toggle" id="hero-toggle" type="button" aria-pressed="false">Vue : <span>Pochoir</span> <i aria-hidden="true">⇄</i></button>

      <div class="hero__foot" aria-hidden="true">
        <span class="scroll-cue">Entre dans la salle <span class="line"></span></span>
        <span class="hero__round" id="hero-round"><b class="hero__round-k">Round</b> <span id="hero-round-n">01</span><i id="hero-round-t">/07</i></span>
      </div>
    </header>

    <!-- ===================== LE PALMARÈS (stats) ==================== -->
    <section class="palmares" aria-label="Le palmarès de la salle">
      <div class="palmares__bg" aria-hidden="true"><div class="media" data-img="/assets/img/bc/anglaise-1.webp" data-label=""></div></div>
      <div class="wrap">
        <span class="eyebrow palmares__eyebrow" data-reveal>Le palmarès</span>
        <div class="stats" id="stats" data-reveal-group></div>
      </div>
    </section>

    <!-- ========================= MARQUEE ========================== -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track" id="marquee"></div>
    </div>

    <!-- ====================== STORY / L'ÂME ======================= -->
    <section class="section" aria-label="L'âme de la salle">
      <div class="wrap split" data-round="1" data-round-name="Notre maison">
        <div data-reveal>
          <span class="eyebrow">Round 01 — Notre maison</span>
          <p class="story__quote" style="margin-top:1.4rem">L'odeur du cuir.<br>Le bruit du cuir.<br>Et le silence quand le coach parle.</p>
        </div>
        <div class="story__body" data-reveal>
          <p class="lead">Les Minimes, c'est la première salle que Boxing Center ait ouverte — et rien n'a été lissé depuis. On tient plus de la vieille salle de Philadelphie que du club de sport : ici, on ne décore pas, on travaille.</p>
          <p class="muted">Trois boxeurs professionnels et une trentaine d'amateurs sont sortis de ces rings. Pas par hasard. Par le travail, la transmission, et une règle qu'on n'écrit nulle part mais que tout le monde respecte : <strong style="color:var(--bone)">le ring ne ment jamais.</strong></p>
        </div>
      </div>

      <div class="wrap" style="margin-top:var(--sec)">
        <div class="feature" data-round="2" data-round-name="L'héritage">
          <div>
            <span class="eyebrow">Round 02 — L'héritage</span>
            <h2 class="display" style="margin:1.2rem 0 1.4rem">Trois rings.<br>Une seule <span class="tint">école.</span></h2>
            <p class="lead">Trois rings. Douze sacs. Un étage pour la caisse. Du matériel de boxeur, usé par les bonnes raisons.</p>
            <p class="muted" style="margin-top:1.2rem">Des coachs qui ont monté les marches, de l'éducative à la compétition.</p>
            <a class="btn btn--ghost" data-magnetic href="/le-club/" style="margin-top:1.6rem"><span>Voir les trois rings</span></a>
          </div>
          <div class="feature__media media" data-img="/assets/img/bc/salle-1.webp" data-label="Le ring"></div>
        </div>
      </div>
    </section>

    <!-- ==================== MUR DES CHAMPIONS ===================== -->
    <section class="forge" id="champions" data-round="3" data-round-name="Le mur des champions" aria-label="Le mur des champions">
      <div class="forge__sticky">
        <div class="wrap forge__grid">
          <div class="forge__head">
            <span class="eyebrow">Round 03 — Le mur des champions</span>
            <h2 class="display forge__title">Ils sont nés <span class="tint">sur ce ring</span></h2>
            <p class="muted forge__intro">Une salle se juge à ceux qu'elle forme. Trois professionnels sont sortis de ces cordes — et derrière eux, l'école ne s'arrête jamais.</p>
            <ol class="forge__rail" id="forge-rail"></ol>
          </div>
          <div class="forge__stage" id="forge-stage"></div>
        </div>
      </div>
    </section>

    <!-- ===================== DISCIPLINES REEL ===================== -->
    <section class="section reel" data-round="4" data-round-name="Ton arme" aria-label="Les disciplines">
      <div class="reel__head">
        <div data-reveal>
          <span class="eyebrow">Round 04 — Ton arme</span>
          <h2 class="display" style="margin-top:1rem">Choisis ta <span class="tint">discipline</span></h2>
        </div>
        <a class="btn btn--ghost" data-magnetic href="/activites/"><span>Toutes les activités</span></a>
      </div>
      <div class="disc-list" id="disciplines"></div>
    </section>

    <!-- ========================= VALUES ========================== -->
    <section class="section" data-round="5" data-round-name="La règle de la maison" aria-label="Nos valeurs">
      <div class="wrap">
        <div data-reveal style="margin-bottom:clamp(2rem,5vw,3rem)">
          <span class="eyebrow">Round 05 — La règle de la maison</span>
          <h2 class="display" style="margin-top:1rem">Ce qui ne se négocie <span class="tint">pas</span></h2>
        </div>
        <div class="values" id="values" data-reveal-group></div>
      </div>
    </section>

    <!-- ================= POUR QUI (scroll-jacked) ================= -->
    <section class="whofor" data-round="6" data-round-name="Pour qui" aria-label="Pour qui">
      <div class="whofor__sticky">
        <div class="wrap whofor__grid">
          <div class="whofor__head">
            <span class="eyebrow">Round 06 — Pour qui</span>
            <h2 class="display whofor__title">Le ring n'exclut <span class="tint">personne</span></h2>
            <p class="muted whofor__intro">Du môme de 3 ans au compétiteur du samedi soir : on a un créneau pour chacun d'eux.</p>
            <ol class="whofor__rail" id="whofor-rail"></ol>
          </div>
          <div class="whofor__stage" id="whofor-stage"></div>
        </div>
      </div>
    </section>

    <!-- ====================== GALLERY TEASER ===================== -->
    <section class="section gallery" aria-label="La galerie">
      <div class="wrap">
        <div class="reel__head" style="margin-bottom:clamp(2rem,4vw,2.6rem)">
          <div data-reveal>
            <span class="eyebrow">En images</span>
            <h2 class="display" style="margin-top:1rem">La salle, <span class="tint">en mouvement</span></h2>
          </div>
          <p class="muted" data-reveal style="max-width:32ch">Le ring, le cuir, les gamins de l'école, les femmes du Lady. Douze images, aucune retouche.</p>
        </div>
        <div class="gallery__grid" data-reveal-group>
          <div class="gallery__cell media" data-reveal data-img="/assets/img/bc/anglaise-2.webp" data-label="Sur le ring"></div>
          <div class="gallery__cell media" data-reveal data-img="/assets/img/bc/training-2.webp" data-label="Pattes d'ours"></div>
          <div class="gallery__cell media" data-reveal data-img="/assets/img/bc/lady-1.webp" data-label="Boxing Lady"></div>
          <div class="gallery__cell media" data-reveal data-img="/assets/img/bc/educative-1.webp" data-label="Boxe éducative"></div>
          <div class="gallery__cell media" data-reveal data-img="/assets/img/bc/anglaise-3.webp" data-label="Sparring"></div>
        </div>
        <a class="btn btn--primary" data-magnetic href="/galerie/" style="margin-top:1.8rem"><span>Voir la galerie</span></a>
      </div>
    </section>

    <!-- ========================== TARIFS ========================= -->
    <section class="section" data-round="7" data-round-name="L'offre" aria-label="L'offre">
      <div class="wrap">
        <div class="reel__head" style="margin-bottom:clamp(2rem,4vw,2.6rem)">
          <div data-reveal>
            <span class="eyebrow">Round 07 — L'offre</span>
            <h2 class="display" style="margin-top:1rem">Sans <span class="tint">détour</span></h2>
          </div>
          <a class="btn btn--ghost" data-magnetic href="/tarifs/"><span>Toutes les formules</span></a>
        </div>
        <div class="tarifs" id="tarifs" data-reveal-group></div>
      </div>
    </section>

    <!-- ========================= LOCAL SEO ======================= -->
    <section class="section localseo" aria-labelledby="seo-title">
      <div class="wrap" style="max-width:74ch">
        <h2 id="seo-title" class="display" style="font-size:clamp(1.8rem,4.2vw,3rem);margin-bottom:1rem">Salle de boxe anglaise aux Minimes — Toulouse Barrière de Paris (31200)</h2>
        <p class="lead">Tu es aux <strong>Minimes</strong>, à Toulouse, trois minutes à pied de la <strong>Barrière de Paris</strong> en <strong>métro ligne B</strong> — dans la <strong>salle historique</strong> du réseau Boxing Center. Ce qu'on y travaille d'abord, c'est la <strong>boxe anglaise</strong>, sur trois rings : que tu n'aies jamais enfilé de gants ou que tu prépares un combat, tu as ta place. Autour, il y a la <strong>boxe éducative dès 3 ans</strong> (Baby Boxe 3/6), le <strong>Boxing Lady</strong> et le cross training.</p>
        <p class="lead" style="margin-top:1rem">Première visite ? Réserve ta <strong>séance d'essai à 10€</strong>, toutes disciplines, sans engagement. 12 rue de Fenouillet, 31200 Toulouse — ouvert du lundi au samedi, 10h–21h30.</p>
      </div>
    </section>

    <!-- ========================= FINAL GONG ====================== -->
    <section class="gong" aria-label="Rejoindre la salle">
      <div class="gong__bg" aria-hidden="true"><div class="media" data-img="/assets/img/bc/anglaise-4.webp" data-label=""></div></div>
      <div class="gong__inner">
        <span class="eyebrow" data-reveal>Le gong</span>
        <h2 class="display" data-reveal style="font-size:var(--step-3)">Ta place t'attend<br><span class="tint">sur le ring.</span></h2>
        <p class="lead" data-reveal>Dix euros pour savoir si le ring est fait pour toi. 12 rue de Fenouillet, Toulouse Minimes.</p>
        <div class="gong__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver mon essai · 10€</span></a>
