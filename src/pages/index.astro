        "email": "boxingcenter31@gmail.com",
        "priceRange": "€€",
        "image": "https://minimes.boxingcenter.fr/assets/img/og.jpg",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "12 rue de Fenouillet",
          "postalCode": "31200",
          "addressLocality": "Toulouse",
          "addressRegion": "Occitanie",
          "addressCountry": "FR"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 43.6256,
          "longitude": 1.4309
        },
        "areaServed": [
          {
            "@type": "Place",
            "name": "Les Minimes"
          },
          {
            "@type": "City",
