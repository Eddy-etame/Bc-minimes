        ],
        "amenityFeature": [
          {
            "@type": "LocationFeatureSpecification",
            "name": "3 rings de boxe",
            "value": true
          },
          {
            "@type": "LocationFeatureSpecification",
            "name": "Zone pattes d'ours",
            "value": true
          },
          {
            "@type": "LocationFeatureSpecification",
            "name": "Salle de prépa physique à l'étage",
            "value": true
          }
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "@id": "https://minimes.boxingcenter.fr/#offres",
          "name": "Offres Boxing Center Minimes",
          "url": "https://minimes.boxingcenter.fr/tarifs/",
          "itemListElement": [
            {
              "@type": "Offer",
              "name": "Séance d'essai",
