---
import SiteContent from "../components/SiteContent.astro";
---
<!doctype html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Boxing Center Minimes — Salle de boxe anglaise à Toulouse (Barrière de Paris, 31200)</title>
  <meta name="description" content="La salle historique du réseau, aux Minimes. Trois rings, l'école dès 3 ans, le Boxing Lady, métro B à trois minutes. Ta séance d'essai est à 10€." />

  <!-- Préconnexion CDN (les libs sont différées) — polices auto-hébergées :
       plus aucune requête vers fonts.googleapis.com / fonts.gstatic.com -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-black-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-latin.woff2" crossorigin />
  <link rel="stylesheet" href="/assets/css/fonts.css?v=b9" />

  <!-- LCP : le poster du hero est peint avant la vidéo ; il est chargé par
       le JS, donc invisible au preload scanner. Le preload rattrape la
       découverte perdue (§5.8 « preload de l'image LCP »). -->
  <link rel="preload" as="image" href="/assets/img/bc/anglaise-1.webp" fetchpriority="high" />

  <link rel="stylesheet" href="/assets/css/base.css?v=b9" />
  <link rel="stylesheet" href="/assets/css/home.css?v=b9" />

  <meta name="keywords" content="salle de boxe Minimes, boxe anglaise Toulouse, club de boxe 31200, boxe Barrière de Paris, boxe éducative enfant Toulouse, Boxing Lady, séance d'essai boxe Toulouse, Boxing Center Minimes" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="author" content="Boxing Center Minimes" />
  <meta name="geo.region" content="FR-31" />
  <meta name="geo.placename" content="Toulouse — Les Minimes" />
  <meta name="geo.position" content="43.6256;1.4309" />
  <meta name="ICBM" content="43.6256, 1.4309" />
  <link rel="canonical" href="https://minimes.boxingcenter.fr/" />
  <meta name="theme-color" content="#0a0908" />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Boxing Center Minimes" />
  <meta property="og:title" content="Boxing Center Minimes — Le berceau des champions, Toulouse" />
  <meta property="og:description" content="Salle historique de boxe anglaise aux Minimes (Toulouse 31200). 3 rings, boxe éducative dès 3 ans, Boxing Lady. Séance d'essai 10€." />
  <meta property="og:url" content="https://minimes.boxingcenter.fr/" />
  <meta property="og:image" content="https://minimes.boxingcenter.fr/assets/img/og.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content="Boxing Center Minimes — la salle historique, trois rings, quartier Barrière de Paris à Toulouse." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Boxing Center Minimes — Le berceau des champions, Toulouse" />
  <meta name="twitter:description" content="Salle historique de boxe anglaise aux Minimes (31200). 3 rings, boxe éducative dès 3 ans, Boxing Lady. Essai 10€." />
  <meta name="twitter:image" content="https://minimes.boxingcenter.fr/assets/img/og.jpg" />

