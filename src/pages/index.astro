        }
      },
      {
        "@type": "WebPage",
        "@id": "https://minimes.boxingcenter.fr/#webpage",
        "url": "https://minimes.boxingcenter.fr/",
        "name": "Boxing Center Minimes — Salle de boxe anglaise à Toulouse (Barrière de Paris, 31200)",
        "description": "La salle historique du réseau, aux Minimes. Trois rings, l'école dès 3 ans, le Boxing Lady, métro B à trois minutes. Ta séance d'essai est à 10€.",
        "isPartOf": {
          "@id": "https://minimes.boxingcenter.fr/#website"
        },
        "about": {
          "@id": "https://minimes.boxingcenter.fr/#salle"
