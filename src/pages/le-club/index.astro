<body data-page="le-club">
  <div class="grain" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"><div class="cursor__ring"><span class="cursor__label">voir</span></div></div>
  <div class="cursor__dot" aria-hidden="true"></div>

  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ========================= PAGE HEAD ======================== -->
    <header class="club-head">
      <div class="club-head__media" aria-hidden="true"><div class="media" data-img="/assets/img/bc/salle-1.webp" data-eager data-label="La salle historique"></div></div>
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="wrap club-head__inner">
        <p class="eyebrow" data-reveal>Le club · Les Minimes</p>
        <h1 class="club-head__title">
          <span class="reveal-mask"><span>La salle</span></span>
          <span class="reveal-mask"><span class="tint">historique.</span></span>
        </h1>
        <p class="lead" data-reveal style="max-width:48ch;margin-top:1.2rem">Celle par laquelle tout a commencé. Trois rings, une odeur de cuir qui ne part pas, et 2016 dans les murs. Bienvenue au berceau.</p>
      </div>
      <div class="hero__foot" aria-hidden="true" style="z-index:4">
        <span class="scroll-cue">L'histoire <span class="line"></span></span>
      </div>
    </header>

    <!-- ========================= HISTOIRE ========================= -->
    <section class="section" aria-label="L'histoire de la salle">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">Depuis 2016</span>
          <h2 class="display" style="margin-top:1rem">Une école, <span class="tint">une lignée</span></h2>
        </div>
        <ol class="timeline" id="timeline"></ol>
      </div>
    </section>

    <!-- ===================== AMBIANCE (parallax) ================== -->
    <section class="ambiance" aria-label="L'ambiance de la salle">
      <div class="ambiance__media" aria-hidden="true"><div class="media" data-img="/assets/img/bc/anglaise-4.webp" data-label="Entre les cordes"></div></div>
      <div class="ambiance__quote wrap">
        <p class="serif" data-reveal>Philadelphie a ses salles. Toulouse a la sienne, au 12 rue de Fenouillet.<br>Les champions, eux, sont les mêmes : <span class="tint">bien réels.</span></p>
      </div>
    </section>

    <!-- ====================== ÉQUIPEMENT ========================= -->
    <section class="section" aria-label="L'équipement">
      <div class="wrap split">
        <div data-reveal>
          <span class="eyebrow">L'équipement</span>
          <h2 class="display" style="margin:1rem 0 1.4rem">Du matériel<br>de <span class="tint">boxeur.</span></h2>
          <p class="lead">Trois rings, douze sacs lourds, une zone de pattes d'ours, la prépa à l'étage. Le matériel est usé : c'est le compliment.</p>
          <p class="muted" style="margin-top:1.2rem">Affilié FFBoxe · FFKMDA · FMMAF. Des coachs passés par l'amateur et la compétition avant de tenir les pattes.</p>
        </div>
        <div class="feature-card" id="specs" data-reveal></div>
      </div>
    </section>

    <!-- ====================== ACCÈS / INFOS ====================== -->
    <section class="section band" aria-label="Accès et infos pratiques">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">Infos pratiques</span>
          <h2 class="display" style="margin-top:1rem">Venir au <span class="tint">club</span></h2>
        </div>
        <!-- une seule ligne : le reste (horaires, accès, téléphone, FAQ) est
             sur /contact/. Deux pages qui répètent la même grille avec les
             mêmes ids, c'est une page de trop. -->
        <div class="contact-grid">
          <div data-reveal-group>
            <div class="contact-line"><span>Adresse</span><a id="addr" href="#" target="_blank" rel="noopener"></a></div>
            <div class="contact-line"><span>Le reste</span><p>Horaires, accès, téléphone et les questions qu'on nous pose : <a href="/contact/">tout est sur la page contact</a>.</p></div>
            <div class="contact-line"><a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver mon essai · 10€</span></a></div>
          </div>
          <div class="map-frame" data-reveal>
            <iframe id="map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Carte Boxing Center Minimes"></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CE QU'ON DEMANDE EN POUSSANT LA PORTE =========
         Des questions de LIEU, propres à cette page — pas la FAQ de
         /contact/ recopiée. Prose, pas accordéon : une visite répond en
         marchant. -->
    <section class="section" aria-label="Ce qu'on demande en poussant la porte">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">Sur le pas de la porte</span>
          <h2 class="display" style="margin-top:1rem">Ce qu'on demande <span class="tint">en entrant</span></h2>
        </div>
        <div class="asks" id="asks" data-reveal-group></div>
      </div>
    </section>

    <!-- ========================= LE RÉSEAU ======================= -->
    <section class="section" aria-label="Le réseau Boxing Center">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">Le réseau</span>
          <h2 class="display" style="margin-top:1rem">Nos autres <span class="tint">salles</span></h2>
        </div>
        <div class="network" id="network" data-reveal-group></div>
      </div>
    </section>

    <!-- ========================= FINAL GONG ====================== -->
    <section class="gong" aria-label="Rejoindre la salle">
      <div class="gong__bg" aria-hidden="true"><div class="media" data-img="/assets/img/bc/anglaise-3.webp" data-label=""></div></div>
      <div class="gong__inner">
        <span class="eyebrow" data-reveal>La porte</span>
        <h2 class="display" data-reveal style="font-size:var(--step-3)">Pousse la porte<br><span class="tint">des Minimes.</span></h2>
        <p class="lead" data-reveal>Le prix d'un ciné pour ta première fois sur un ring. Pousse la porte.</p>
        <div class="gong__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver mon essai · 10€</span></a>
          <a class="btn btn--ghost" data-magnetic href="/"><span>Retour à l'accueil</span></a>
        </div>
      </div>
    </section>

  </main>

  <div id="footer"></div>
  <!-- pastille "Une question ?" → appel direct de la salle (STANDARDS §1) -->
  <a class="chatbot" href="tel:+33562244682" aria-label="Une question ? Appelle la salle Boxing Center Minimes — 05 62 24 46 82">
    <span class="chatbot__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.4 14V8.2A5.2 5.2 0 0 1 11.6 3h1.5a5.2 5.2 0 0 1 5.2 5.2V14"/><path d="M6.4 8.9H5.1a2.3 2.3 0 0 0-2.3 2.3v.6a2.3 2.3 0 0 0 2.3 2.3h1.3"/><path d="M6.4 14h11.9v3.1a1.6 1.6 0 0 1-1.6 1.6H8a1.6 1.6 0 0 1-1.6-1.6z"/><path d="M8.7 18.7V20a1 1 0 0 0 1 1h5a1 1 0 0 0 1-1v-1.3"/></svg></span>
    <span class="chatbot__label">Appelle la salle</span>
  </a>

