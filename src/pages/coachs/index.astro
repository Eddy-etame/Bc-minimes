<body data-page="coachs">
  <div class="grain" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"><div class="cursor__ring"><span class="cursor__label">voir</span></div></div>
  <div class="cursor__dot" aria-hidden="true"></div>

  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ========================= EN-TÊTE ========================== -->
    <section class="page-head page-head--co" aria-label="Les coachs">
      <div class="page-head__bg" aria-hidden="true"><div class="media" data-img="/assets/img/photos/sparring-graff-1200.webp" data-eager data-label=""></div></div>
      <img class="co-head__cut" src="/assets/img/bc/cutouts/coach-mehdi.webp" width="236" height="452" alt="" aria-hidden="true" decoding="async" />
      <div class="wrap">
        <span class="eyebrow" data-reveal>L’encadrement · Les Minimes</span>
        <h1 class="display" style="margin:1rem 0 0"><span class="reveal-mask"><span>Ceux qui </span></span><span class="reveal-mask"><span class="tint">tiennent les pattes.</span></span></h1>
        <p class="lead page-head__lead" data-reveal>Une salle vaut ses coachs. Aux Minimes, on ne fait pas de la garderie sportive : on te reprend le geste, on te pousse au round de trop, on te connaît par ton prénom. Voilà les gens à qui tu vas serrer la main.</p>
      </div>
    </section>

    <!-- ========================== LE PILIER ======================= -->
    <section class="section section--tight" aria-label="Le coach principal">
      <div class="wrap">
        <div class="reel__head" style="margin-bottom:clamp(1.8rem,4vw,2.6rem)">
          <div data-reveal>
            <span class="eyebrow">Le patron</span>
            <h2 class="display display--sm" style="margin-top:1rem">Le coach <span class="tint">de la maison</span></h2>
          </div>
          <p class="muted" data-reveal style="max-width:34ch">Un seul homme sur presque tous les créneaux de la semaine. Voilà ce que ça donne.</p>
        </div>
        <div class="pillar" id="pillar" data-reveal></div>
      </div>
    </section>

    <!-- ========================= LE STAFF ========================= -->
    <section class="section band section--tight" aria-label="L’équipe de coachs">
      <div class="wrap">
        <div data-reveal style="margin-bottom:clamp(1.8rem,4vw,2.6rem)">
          <span class="eyebrow">L’équipe</span>
          <h2 class="display display--sm" style="margin-top:1rem">Et derrière <span class="tint">le patron</span></h2>
        </div>
        <div class="roster" id="roster" data-reveal-group></div>
        <p class="co-pending" id="pending" data-reveal></p>
      </div>
    </section>

    <!-- ROULETTE PROMO — apres l equipe : il sait qui va l encadrer.
         Les deux offres phares y tournent en alternance ; le lien suit la
         case affichee. Montee par site.js > mountPromoWheels(). -->
    <div class="wrap" data-promo></div>


    <!-- ================== QUI EST LÀ, QUEL JOUR ===================
         La page présentait quatre personnes et laissait la question
         suivante sans réponse : « d’accord, mais il est là QUAND ? ».
         On répondait « va voir le planning » — et le planning s’ouvrait
         sur la semaine entière.

         Cette grille est DÉRIVÉE de PLANNING (data.js) : les jours, les
         noms et les comptes sont calculés, jamais tapés ici (§0.10).
         Elle ne peut donc pas se désynchroniser du poster, et chaque
         nom ouvre la grille déjà filtrée sur ce coach ET ce jour-là. -->
    <section class="section section--tight" aria-label="Les coachs jour par jour">
      <div class="wrap">
        <div class="reel__head" style="margin-bottom:clamp(1.8rem,4vw,2.6rem)">
          <div data-reveal>
            <span class="eyebrow">La semaine</span>
            <h2 class="display display--sm" style="margin-top:1rem">Qui est là, <span class="tint">quel jour</span></h2>
          </div>
          <p class="muted" data-reveal style="max-width:34ch">Tu cherches quelqu’un en particulier ? Clique sur son nom : la grille s’ouvre déjà filtrée sur lui, ce jour-là.</p>
        </div>
        <div class="cweek" id="cweek" data-reveal-group></div>
        <p class="muted" data-reveal style="margin-top:clamp(1.4rem,3vw,2rem);font:500 var(--step--1)/1.6 var(--f-mono);letter-spacing:.04em;max-width:64ch;border-left:2px solid var(--mark);padding-left:1rem">Le dimanche n’est pas dans cette liste : la salle est fermée. Le reste du temps, en dehors des cours, les rings et les sacs sont en accès libre — personne ne t’encadre, mais il y a toujours quelqu’un dans la salle.</p>
      </div>
    </section>

    <!-- ========================= FINAL GONG ====================== -->
    <section class="gong" aria-label="Réserver une séance">
      <div class="gong__bg" aria-hidden="true"><div class="media" data-img="/assets/img/photos/allee-sacs-1200.webp" data-label=""></div></div>
      <div class="gong__inner">
        <span class="eyebrow" data-reveal>La poignée de main</span>
        <h2 class="display" data-reveal style="font-size:var(--step-3)">Viens te faire<br><span class="tint">corriger le jab.</span></h2>
        <p class="lead" data-reveal>Le coach te prend en main dès la première minute. Tu ressors avec un jab que tu n’avais pas.</p>
        <div class="gong__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://boutique.boxingcenter.fr/inscription?product=offre-duo&step=1&utm_source=site&utm_medium=cta&utm_campaign=bc-minimes"><span>Je prends ma place — 29€</span></a><a class="btn btn--ghost" data-magnetic href="https://boutique.boxingcenter.fr/seance-essai?utm_source=site&utm_medium=cta&utm_campaign=bc-minimes"><span>Tester une séance · 10€</span></a>
          <a class="btn btn--ghost" data-magnetic href="/plannings/"><span>Voir le planning</span></a>
        </div>
      </div>
    </section>

  </main>

