  <!-- page-scoped : pilier (photo prouvée sur fond sombre, énergie mur de
       champion) + tuiles nom N&B pour les coachs sans portrait vérifié -->
  <style is:inline>
    /* l'en-tête partage .page-head (base.css) — la répétition est honnête.
       Ce qui appartient à CETTE page : la silhouette du patron, à l'échelle,
       fondue dans le bord droit. C'est la page des visages : elle commence
       par un visage. */
    .page-head--co .page-head__bg { opacity: .18; }
    .co-head__cut { position: absolute; right: 0; bottom: 0; z-index: 1; height: 88%; width: auto; object-fit: contain; object-position: bottom right; filter: grayscale(1) contrast(1.1) brightness(.55); -webkit-mask-image: linear-gradient(90deg, transparent, #000 45%); mask-image: linear-gradient(90deg, transparent, #000 45%); pointer-events: none; }
    @media (max-width: 900px){ .co-head__cut { display: none; } }

    /* ---- LE PILIER (Mehdi B) ---- */
    .pillar { display: grid; grid-template-columns: 1fr; gap: clamp(1.6rem,4vw,3.5rem); align-items: stretch; border: 1px solid var(--line); background: var(--ink); }
    @media (min-width: 900px){ .pillar { grid-template-columns: .85fr 1.15fr; } }
    .pillar__stage { position: relative; overflow: hidden; min-height: 26rem; background: radial-gradient(120% 90% at 50% 100%, rgba(110,10,8,.4), var(--black) 70%); display: flex; align-items: flex-end; justify-content: center; }
    .pillar__bigname { position: absolute; inset: 0; display: grid; place-items: center; z-index: 0; font-family: var(--f-display); text-transform: uppercase; font-size: clamp(4rem,13vw,8rem); line-height: .8; color: transparent; -webkit-text-stroke: 1.5px var(--line); letter-spacing: -.02em; white-space: nowrap; }
    .pillar__cut { position: relative; z-index: 1; height: 100%; max-height: 34rem; width: auto; object-fit: contain; object-position: bottom center; filter: grayscale(1) contrast(1.08) brightness(.98) drop-shadow(0 24px 34px rgba(0,0,0,.55)); transition: filter .6s var(--ease), transform 1s var(--ease-out); transform: translateY(6px) scale(1.02); }
    .pillar:hover .pillar__cut, .pillar:active .pillar__cut { filter: contrast(1.06) saturate(1.05) brightness(1); transform: translateY(0) scale(1); }
    .pillar__body { padding: clamp(1.8rem,3.5vw,3rem); display: flex; flex-direction: column; }
    .pillar__role { display: inline-flex; align-items: center; gap: .7ch; font: 700 var(--step--1)/1.4 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--bone); }
    .pillar__role::before { content: ""; width: 18px; height: 2px; background: var(--red); flex: 0 0 18px; }
    .pillar__role i { color: var(--bone-dim); font-style: normal; }
    .pillar__name { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(2.4rem,6vw,4.4rem); line-height: .9; margin: .5rem 0 1.1rem; color: var(--bone); }
    .pillar__disc { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.4rem; }
    .pillar__disc li { font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .05em; text-transform: uppercase; color: var(--bone-dim); border: 1px solid var(--line); padding: .5em .8em; }
    .pillar__bio { font-size: var(--step-1); line-height: 1.4; color: var(--bone); font-weight: 500; max-width: 48ch; }
    .pillar__note { margin-top: 1rem; color: var(--muted); font: 500 var(--step--1)/1.5 var(--f-mono); letter-spacing: .04em; }
    .pillar__cta { margin-top: auto; padding-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 1rem; }

    /* ---- LE RESTE DU STAFF (tuiles nom, pas de photo empruntée) ---- */
    .roster { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); grid-template-columns: 1fr; }
    @media (min-width: 680px){ .roster { grid-template-columns: repeat(3,1fr); } }
    .coach { position: relative; background: var(--ink); padding: clamp(1.8rem,3.2vw,2.4rem); min-height: 17rem; display: flex; flex-direction: column; gap: 1rem; overflow: hidden; border-top: 2px solid transparent; transition: background .35s, border-color .35s; }
    .coach:hover, .coach:active { background: var(--ink-2); border-top-color: var(--red); }
    .coach__mono { position: absolute; top: -1.5rem; right: -.5rem; font-family: var(--f-display); font-size: clamp(6rem,14vw,10rem); line-height: .7; color: transparent; -webkit-text-stroke: 1.5px var(--line-soft); pointer-events: none; z-index: 0; transition: -webkit-text-stroke-color .4s; }
    .coach:hover .coach__mono, .coach:active .coach__mono { -webkit-text-stroke-color: rgba(225,6,0,.4); }
    .coach__body { position: relative; z-index: 1; margin-top: 1.4rem; }
    .coach__role { display: inline-flex; align-items: center; gap: .7ch; font: 700 var(--step--1)/1.3 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--bone); }
    .coach__role::before { content: ""; width: 14px; height: 2px; background: var(--red); flex: 0 0 14px; }
    .coach__name { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(1.8rem,3.6vw,2.6rem); line-height: 1; margin: .45rem 0 .7rem; color: var(--bone); }
    .coach__note { position: relative; z-index: 1; color: var(--muted); font-size: var(--step--1); line-height: 1.5; max-width: 32ch; }
    .coach__pending { position: relative; z-index: 1; margin-top: auto; align-self: flex-start; font: 700 .62rem/1 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--bone-dim); border: 1px dashed var(--line); padding: .55em .8em; }
    .co-pending { margin-top: clamp(1.6rem,4vw,2.4rem); color: var(--muted); font: 500 var(--step--1)/1.6 var(--f-mono); letter-spacing: .04em; max-width: 64ch; border-left: 2px solid var(--red); padding-left: 1rem; }
  </style>

