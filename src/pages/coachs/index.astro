  <!-- page-scoped : pilier (photo prouvée sur fond sombre, énergie mur de
       champion) + tuiles nom N&B pour les coachs sans portrait vérifié -->
  <style is:inline>
    /* l’en-tête partage .page-head (base.css) — la répétition est honnête.
       Ce qui appartient à CETTE page : la silhouette du patron, à l’échelle,
       fondue dans le bord droit. C’est la page des visages : elle commence
       par un visage. */
    .page-head--co .page-head__bg { opacity: .18; }
    .co-head__cut { position: absolute; right: 0; bottom: 0; z-index: 1; height: 88%; width: auto; object-fit: contain; object-position: bottom right; filter: grayscale(1) contrast(1.1) brightness(.55); -webkit-mask-image: linear-gradient(90deg, transparent, #000 45%); mask-image: linear-gradient(90deg, transparent, #000 45%); pointer-events: none; }
    @media (max-width: 900px){ .co-head__cut { display: none; } }

    /* ---- LE PILIER (Mehdi B) ---- */
    /* v4 : cette carte etait un aplat SOMBRE sur une page sombre. La page
       est devenue claire, ses encres aussi — la carte doit suivre, sinon
       elle porte du texte navy sur du navy. Carte blanche + filet. */
    .pillar { display: grid; grid-template-columns: 1fr; gap: clamp(1.6rem,4vw,3.5rem); align-items: stretch; border: 1px solid var(--hair); border-radius: var(--radius-lg); overflow: hidden; background: var(--paper); box-shadow: var(--shadow-sm); }
    @media (min-width: 900px){ .pillar { grid-template-columns: .85fr 1.15fr; } }
    .pillar__stage { position: relative; overflow: hidden; min-height: 26rem; background: radial-gradient(120% 90% at 50% 100%, rgba(38,64,115,.4), var(--black) 70%); display: flex; align-items: flex-end; justify-content: center; }
    .pillar__bigname { position: absolute; inset: 0; display: grid; place-items: center; z-index: 0; font-family: var(--f-display); text-transform: uppercase; font-size: clamp(4rem,13vw,8rem); line-height: .8; color: transparent; -webkit-text-stroke: 1.5px var(--line); letter-spacing: -.02em; white-space: nowrap; }
    .pillar__cut { position: relative; z-index: 1; height: 100%; max-height: 34rem; width: auto; object-fit: contain; object-position: bottom center; filter: grayscale(1) contrast(1.08) brightness(.98) drop-shadow(0 24px 34px rgba(0,0,0,.55)); transition: filter .6s var(--ease), transform 1s var(--ease-out); transform: translateY(6px) scale(1.02); }
    .pillar:hover .pillar__cut, .pillar:active .pillar__cut { filter: contrast(1.06) saturate(1.05) brightness(1); transform: translateY(0) scale(1); }
    .pillar__body { padding: clamp(1.8rem,3.5vw,3rem); display: flex; flex-direction: column; }
    .pillar__role { display: inline-flex; align-items: center; gap: .7ch; font: 700 var(--step--1)/1.4 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--bone); }
    .pillar__role::before { content: ""; width: 18px; height: 2px; background: var(--mark); flex: 0 0 18px; }
    .pillar__role i { color: var(--bone-dim); font-style: normal; }
    .pillar__name { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(2.4rem,6vw,4.4rem); line-height: .9; margin: .5rem 0 1.1rem; color: var(--bone); }
    .pillar__disc { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.4rem; }
    .pillar__disc li { font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .05em; text-transform: uppercase; color: var(--bone-dim); border: 1px solid var(--line); padding: .5em .8em; }
    .pillar__bio { font-size: var(--step-1); line-height: 1.4; color: var(--bone); font-weight: 500; max-width: 48ch; }
    .pillar__note { margin-top: 1rem; color: var(--muted); font: 500 var(--step--1)/1.5 var(--f-mono); letter-spacing: .04em; }
    /* la charge de travail, DÉRIVÉE du planning (coachs.js) — un chiffre
       qui se recompte tout seul vaut mieux qu’un adjectif */
    .pillar__week { margin-top: .9rem; display: inline-flex; align-items: center; gap: .7ch; padding: .5em .9em; border-left: 3px solid var(--mark); background: var(--paper-2); font: 500 var(--step--1)/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--read); }
    .pillar__week b { color: var(--bone); font-weight: 700; }
    .pillar__cta { margin-top: auto; padding-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 1rem; }

    /* ---- LE RESTE DU STAFF (tuiles nom, pas de photo empruntée) ---- */
    .roster { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); grid-template-columns: 1fr; }
    @media (min-width: 680px){ .roster { grid-template-columns: repeat(3,1fr); } }
    /* v4 : cette carte etait un aplat SOMBRE sur une page sombre. La page
       est devenue claire, ses encres aussi — la carte doit suivre, sinon
       elle porte du texte navy sur du navy. Carte blanche + filet. */
    .coach { position: relative; background: var(--paper); border: 1px solid var(--hair); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: clamp(1.8rem,3.2vw,2.4rem); min-height: 17rem; display: flex; flex-direction: column; gap: 1rem; overflow: hidden; border-top: 2px solid transparent; transition: background .35s, border-color .35s; }
    .coach:hover, .coach:active { box-shadow: var(--shadow-md); border-top-color: var(--mark); }
    .coach__mono { position: absolute; top: -1.5rem; right: -.5rem; font-family: var(--f-display); font-size: clamp(6rem,14vw,10rem); line-height: .7; color: transparent; -webkit-text-stroke: 1.5px var(--line-soft); pointer-events: none; z-index: 0; transition: -webkit-text-stroke-color .4s; }
    .coach:hover .coach__mono, .coach:active .coach__mono { -webkit-text-stroke-color: rgba(174,188,207,.45); }
    .coach__body { position: relative; z-index: 1; margin-top: 1.4rem; }
    .coach__role { display: inline-flex; align-items: center; gap: .7ch; font: 700 var(--step--1)/1.3 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--bone); }
    .coach__role::before { content: ""; width: 14px; height: 2px; background: var(--mark); flex: 0 0 14px; }
    .coach__name { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(1.8rem,3.6vw,2.6rem); line-height: 1; margin: .45rem 0 .7rem; color: var(--bone); }
    .coach__note { position: relative; z-index: 1; color: var(--muted); font-size: var(--step--1); line-height: 1.5; max-width: 32ch; }
    /* la tuile sans portrait n’était qu’un texte : elle ne menait nulle
       part. Elle mène maintenant aux créneaux de la personne — filtrés. */
    .coach__link { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: .7ch; min-height: 44px; margin-top: .6rem; font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--bone); border-bottom: 2px solid var(--mark); align-self: flex-start; transition: color .3s, gap .3s; }
    .coach__link:hover, .coach__link:active { color: var(--white); gap: 1.4ch; }
    .coach__pending { position: relative; z-index: 1; margin-top: auto; align-self: flex-start; font: 700 .75rem/1 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--bone-dim); border: 1px dashed var(--line); padding: .55em .8em; }
    .co-pending { margin-top: clamp(1.6rem,4vw,2.4rem); color: var(--muted); font: 500 var(--step--1)/1.6 var(--f-mono); letter-spacing: .04em; max-width: 64ch; border-left: 2px solid var(--mark); padding-left: 1rem; }

    /* ---- QUI EST LÀ, QUEL JOUR (dérivé de PLANNING) ----
       Six colonnes-jour au bureau, empilées au téléphone. Volontairement
       PAS le même objet que la grille de /plannings/ : là-bas on cherche
       un créneau, ici on cherche quelqu’un. Chaque ligne est un lien de
       44px de haut vers la grille pré-filtrée (coach + jour). */
    .cweek { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); grid-template-columns: 1fr; }
    @media (min-width: 640px){ .cweek { grid-template-columns: repeat(2,1fr); } }
    @media (min-width: 1080px){ .cweek { grid-template-columns: repeat(6,1fr); } }
    .cwd { background: var(--paper); border: 1px solid var(--hair); border-radius: var(--radius-lg); padding: clamp(1rem,2vw,1.3rem); display: flex; flex-direction: column; gap: .8rem; }
    .cwd__h { display: flex; align-items: baseline; justify-content: space-between; gap: .6ch; font-family: var(--f-display); text-transform: uppercase; font-size: clamp(1.05rem,2vw,1.3rem); line-height: 1; color: var(--bone); border-bottom: 2px solid var(--mark); padding-bottom: .55rem; }
    .cwd__h i { font: 700 .75rem/1 var(--f-mono); font-style: normal; color: var(--bone-dim); }
    .cwd__list { display: grid; gap: .4rem; }
    /* le nom est le lien : toute la ligne clique, pas seulement le mot */
    .cwd__a { display: flex; align-items: center; justify-content: space-between; gap: .8ch; min-height: 44px; padding: .5rem .6rem; background: var(--paper-2); border-left: 2px solid var(--hair); transition: border-color .3s, background .3s; }
    .cwd__a:hover, .cwd__a:focus-visible, .cwd__a:active { border-left-color: var(--mark); background: var(--char); }
    .cwd__n { font: 700 var(--step--1)/1.2 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--bone); }
    .cwd__c { font: 500 .75rem/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--bone-dim); white-space: nowrap; }
  </style>

