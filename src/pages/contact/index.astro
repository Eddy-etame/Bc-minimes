  <div class="cursor__dot" aria-hidden="true"></div>

  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ========================= EN-TÊTE ========================== -->
    <section class="page-head page-head--con" aria-label="Contact">
      <div class="page-head__bg" aria-hidden="true"><div class="media" data-img="/assets/img/bc/training-1.webp" data-eager data-label=""></div></div>
      <div class="wrap">
        <span class="eyebrow" data-reveal>Contact · Les Minimes</span>
        <h1 class="display" style="margin:1rem 0 0"><span class="reveal-mask"><span>On répond, </span></span><span class="reveal-mask"><span class="tint">pour de vrai.</span></span></h1>
        <p class="lead page-head__lead" data-reveal>Une question sur un créneau, un niveau, un enfant à inscrire ? Le plus simple, c'est le téléphone. Un coach décroche — pas un formulaire, pas un robot.</p>
        <div class="tel-hero" data-reveal>
          <a href="tel:+33562244682">05 62 24 46 82</a>
          <span class="tel-hero__note">Lun–Sam · <b>10h – 21h30</b><br>12 rue de Fenouillet, 31200 Toulouse</span>
        </div>
      </div>
    </section>

    <!-- ==================== COORDONNÉES + CARTE =================== -->
    <section class="section band con-band" aria-label="Adresse, accès et horaires">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">Où nous trouver</span>
          <h2 class="display display--sm" style="margin-top:1rem">L'adresse, <span class="tint">l'accès</span></h2>
        </div>
        <div class="contact-grid">
          <div data-reveal-group>
            <div class="contact-line"><span>Adresse</span><a id="addr" href="#" target="_blank" rel="noopener"></a></div>
            <div class="contact-line"><span>Accès</span><ul id="access"></ul></div>
            <div class="contact-line"><span>Horaires</span><p id="hours"></p></div>
            <div class="contact-line"><span>Téléphone</span><a id="phone" href="#"></a></div>
            <div class="contact-line"><span>E-mail</span><a id="email" href="#"></a></div>
            <div class="contact-line"><a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver mon essai · 10€</span></a></div>
          </div>
          <div class="map-frame" data-reveal>
            <iframe id="map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Carte Boxing Center Minimes — 12 rue de Fenouillet, Toulouse"></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================= FAQ LOCALE ====================== -->
    <section class="section" aria-label="Questions fréquentes">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">FAQ locale</span>
          <h2 class="display display--sm" style="margin-top:1rem">Les questions <span class="tint">qu'on nous pose</span></h2>
        </div>
        <div class="faq" id="faq"></div>
      </div>
    </section>

    <!-- ========================= FINAL GONG ====================== -->
    <section class="gong" aria-label="Réserver une séance">
      <div class="gong__bg" aria-hidden="true"><div class="media" data-img="/assets/img/bc/anglaise-3.webp" data-label=""></div></div>
      <div class="gong__inner">
        <span class="eyebrow" data-reveal>Décroche</span>
        <h2 class="display" data-reveal style="font-size:var(--step-3)">Pas envie<br><span class="tint">d'appeler ?</span></h2>
        <p class="lead" data-reveal>Réserve en ligne, on t'attend au 12 rue de Fenouillet.</p>
        <div class="gong__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver mon essai · 10€</span></a>
          <a class="btn btn--ghost" data-magnetic href="/plannings/"><span>Voir le planning</span></a>
        </div>
      </div>
    </section>

  </main>

  <div id="footer"></div>

