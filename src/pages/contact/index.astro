  <!-- page-scoped : en-tête contact + numéro héroïsé -->
  <style is:inline>
    /* l'en-tête partage .page-head (base.css) — la répétition est honnête.
       Ce qui appartient à CETTE page : le numéro à l'échelle du display.
       C'est la page du contact : elle commence par le téléphone. */
    .page-head--con { border-bottom: 0; }
    .page-head--con .page-head__bg { opacity: .2; }
    .tel-hero { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem 1.4rem; margin-top: clamp(1.4rem,4vw,2.2rem); border-top: 1px solid var(--line); padding-top: clamp(1.4rem,3vw,2rem); }
    /* le chiffre est énorme, mais line-height .82 écrasait la BOÎTE du lien à
       30px : le pouce vise la boîte, pas le glyphe (QA ≥44px) */
    .tel-hero a { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--f-display); text-transform: uppercase; font-size: clamp(2.3rem,7.5vw,4.8rem); line-height: .82; color: var(--bone); transition: color .3s; }
    .tel-hero a:hover { color: var(--mark); }
    .tel-hero__note { font: 700 var(--step--1)/1.5 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--bone-dim); }
    /* opening hours are real info → legible bone, not 4:1 red */
    .tel-hero__note b { color: var(--bone); font-weight: 700; }
    /* la carte compacte reprend .contact-line de club.css, resserrée */
    .con-band .contact-grid { grid-template-columns: 1fr; }
    @media (min-width: 900px){ .con-band .contact-grid { grid-template-columns: 1.1fr 1fr; } }
    .con-band .map-frame { aspect-ratio: 5/4; }
  </style>

